{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dryer.yemelianov.dev/schemas/lockfile.schema.json",
  "title": "Dryer machine.lock v4",
  "description": "Generated capture of one successful resolution. Users do not edit it. Normative reference implementation: crates/machine-lock. v4 adds required, versioned controller build inputs (exact board/chip/driver packages, target, toolchain, memory, protocol/ABI, and features) alongside the v3 controller-local safety partition. Registry source identity and expected reproducible output hashes remain deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "machine_hash", "resolver_version", "packages", "safety_profile", "controllers"],
  "properties": {
    "lock_version": { "const": 4 },
    "machine_hash": { "$ref": "#/$defs/sha256" },
    "resolver_version": { "type": "string" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/locked_package" }
    },
    "safety_profile": { "$ref": "#/$defs/locked_package" },
    "controllers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/locked_controller" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "locked_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifest_hash", "content_hash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9_-]*@.+$" },
        "manifest_hash": { "$ref": "#/$defs/sha256" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "locked_controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "resolved_resources", "safety", "build"],
      "properties": {
        "board": { "type": "string", "minLength": 1 },
        "resolved_resources": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "safety": { "$ref": "#/$defs/controller_safety" },
        "build": { "$ref": "#/$defs/controller_build" }
      }
    },
    "controller_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "states"],
      "properties": {
        "schema": { "const": "dryer.controller-safety/v1" },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/safe_state" }
        }
      }
    },
    "safe_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "class", "resource", "state"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "state": { "enum": ["off", "disabled"] },
        "heartbeat_timeout_us": { "type": "integer", "minimum": 1 },
        "sensor": { "type": "string", "minLength": 1 }
      }
    },
    "controller_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "board",
        "chip",
        "target_triple",
        "toolchain",
        "build_profile",
        "protocol_version",
        "abi_version",
        "flash_bytes",
        "ram_bytes",
        "bootloader_offset_bytes",
        "features",
        "native_drivers"
      ],
      "properties": {
        "schema": { "const": "dryer.controller-build-plan/v1" },
        "board": { "type": "string", "minLength": 1 },
        "chip": { "type": "string", "minLength": 1 },
        "target_triple": { "type": "string", "minLength": 1 },
        "toolchain": { "type": "string", "minLength": 1 },
        "build_profile": { "type": "string", "minLength": 1 },
        "protocol_version": { "type": "string", "pattern": "^[a-z.]+/v[1-9][0-9]*$" },
        "abi_version": { "type": "string", "pattern": "^[a-z.]+/v[1-9][0-9]*$" },
        "flash_bytes": { "type": "integer", "minimum": 1 },
        "ram_bytes": { "type": "integer", "minimum": 1 },
        "bootloader_offset_bytes": { "type": "integer", "minimum": 0 },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "native_drivers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
