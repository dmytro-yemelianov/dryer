{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/lockfile.schema.json",
  "title": "ForgeOS machine.lock v1",
  "description": "Generated capture of one successful resolution. Users do not edit it. Normative reference implementation: crates/machine-lock. v1 field scope is deliberately partial (no registry source, firmware targets, protocol versions, feature flags, or safety-profile versions yet) — see the crate docs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "machine_hash", "resolver_version", "packages", "safety_profile", "controllers"],
  "properties": {
    "lock_version": { "const": 1 },
    "machine_hash": { "$ref": "#/$defs/sha256" },
    "resolver_version": { "type": "string" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/locked_package" }
    },
    "safety_profile": { "$ref": "#/$defs/locked_package" },
    "controllers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["board", "resolved_resources"],
        "properties": {
          "board": { "type": "string" },
          "resolved_resources": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "locked_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifest_hash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9_-]*@.+$" },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
